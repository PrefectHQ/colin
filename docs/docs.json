{
  "$schema": "https://mintlify.com/docs.json",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "dark": "#222831",
      "light": "#EEEEEE"
    },
    "decoration": "gradient"
  },
  "colors": {
    "dark": "#00d4ff",
    "light": "#00d4ff",
    "primary": "#007BFF"
  },
  "description": "Keep agent skills fresh.",
  "errors": {
    "404": {
      "description": "You've wandered outside the context.",
      "redirect": false,
      "title": "Don't panic."
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/prefecthq/colin"
    }
  },
  "name": "Colin",
  "navbar": {
    "primary": {
      "href": "https://github.com/prefecthq/colin",
      "type": "github"
    }
  },
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "getting-started/welcome",
              "getting-started/installation",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Projects",
            "pages": [
              "projects/documents",
              "projects/references",
              "projects/organization",
              "projects/templating",
              "projects/dependencies",
              "projects/variables"
            ]
          },
          {
            "group": "Providers",
            "pages": [
              "providers/providers",
              "providers/project",
              "providers/github",
              "providers/http",
              "providers/mcp",
              "providers/llm",
              "providers/s3"
            ]
          },
          {
            "group": "Renderers",
            "pages": [
              "renderers/renderers",
              "renderers/markdown",
              "renderers/json",
              "renderers/yaml"
            ]
          },
          {
            "group": "Running Colin",
            "pages": [
              "running/run",
              "running/cli",
              "running/skills",
              "running/materialization",
              "running/configuration"
            ]
          }
        ],
        "icon": "book"
      }
    ]
  },
  "search": {
    "prompt": "Search the docs..."
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "dark-plus",
        "light": "snazzy-light"
      }
    }
  },
  "theme": "almond"
}
